{
  "info": {
    "_postman_id": "497ee1ab-dbf5-405d-bb2b-dd745f033fb9",
    "name": "Product API",
    "description": "Collection untuk assignment Authentication & Testing API. Folder Auth mendaftarkan dan login user baru secara otomatis (kredensial acak per run, aman dijalankan berulang lewat Collection Runner). Folder Products menjalankan siklus CRUD penuh: create dengan token yang sama dipakai untuk read, update, delete, lalu membuktikan data sudah terhapus (404). category_id default mengacu ke baris seed 'Telur Ayam Negeri' (id 1) dari sql/02_dml.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "id": "4c78947e-3606-41c8-9588-8ea5739593e6",
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('reg_username', 'tester_' + suffix);",
                  "pm.environment.set('reg_email', 'tester_' + suffix + '@example.com');",
                  "pm.environment.set('reg_password', 'Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response berisi id user', function () {",
                  "  pm.expect(json.data.id).to.be.a('number');",
                  "});",
                  "pm.test('Response tidak membocorkan password_hash', function () {",
                  "  pm.expect(json.data.password_hash).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Tester\",\n  \"username\": \"{{reg_username}}\",\n  \"email\": \"{{reg_email}}\",\n  \"password\": \"{{reg_password}}\",\n  \"role\": \"seller\",\n  \"city\": \"Jakarta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "id": "3b7a6671-a761-4037-b28c-06a71f315173",
          "name": "Login - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response berisi token', function () {",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "});",
                  "",
                  "pm.environment.set('token', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{reg_username}}\",\n  \"password\": \"{{reg_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "id": "fb950f1e-0994-4de3-a22c-7dc6ba53cb1f",
          "name": "Login - Wrong Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{reg_username}}\",\n  \"password\": \"password-salah-123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
